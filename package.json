{
  "name": "melonspeak",
  "version": "1.0.0",
  "description": "MelonSpeak - fully offline neural TTS browser extension",
  "author": "AngKS",
  "license": "MIT",
  "homepage": "https://github.com/AngKS/melonspeak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngKS/melonspeak.git"
  },
  "bugs": {
    "url": "https://github.com/AngKS/melonspeak/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/icons.mjs && node scripts/build.mjs",
    "build:dev": "node scripts/icons.mjs && node scripts/build.mjs --dev",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:e2e": "node scripts/smoke.mjs --download",
    "smoke:firefox": "node scripts/smoke-firefox.mjs",
    "smoke:firefox:e2e": "node scripts/smoke-firefox.mjs --download"
  },
  "keywords": [
    "text-to-speech",
    "tts",
    "offline",
    "browser-extension",
    "accessibility",
    "onnx",
    "kokoro",
    "piper"
  ],
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mintplex-labs/piper-tts-web": "1.0.4",
    "@mozilla/readability": "0.6.0",
    "kokoro-js": "1.2.1",
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@types/chrome": "0.2.5",
    "esbuild": "0.28.1",
    "puppeteer-core": "25.4.0",
    "typescript": "7.0.2"
  },
  "private": true
}
