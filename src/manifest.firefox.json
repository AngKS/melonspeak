{
  "manifest_version": 3,
  "name": "MelonSpeak",
  "description": "Read any page aloud with fully offline neural text-to-speech. Nothing ever leaves your device.",
  "homepage_url": "https://github.com/AngKS/melonspeak",
  "browser_specific_settings": {
    "gecko": {
      "id": "melonspeak@melonspeak.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "sidebar_action": {
    "default_title": "MelonSpeak — Now Reading",
    "default_panel": "reader/reader.html",
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "open_at_install": false
  },
  "action": {
    "default_title": "MelonSpeak",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
